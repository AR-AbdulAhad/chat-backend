{
  "name": "amai-backend",
  "version": "1.0.0",
  "description": "Amai private two-person messaging backend",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/jobs/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "db:apply-sql": "node scripts/apply-migrations.mjs",
    "seed:dev": "tsx prisma/seed.ts",
    "provision": "tsx scripts/provision.ts",
    "test": "vitest run",
    "audit:deps": "npm audit --omit=dev"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.16",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.1",
    "rate-limit-redis": "^6.0.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
