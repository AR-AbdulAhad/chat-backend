# ---- Amai backend configuration (copy to .env and fill in; never commit .env) ----
NODE_ENV=production
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
# Number of reverse proxies in front of the API (Nginx = 1)
TRUST_PROXY=1
PUBLIC_API_URL=https://api.example.com
# Comma-separated browser origins allowed by CORS (the Android app needs none)
CORS_ORIGINS=

DATABASE_URL=postgresql://amai:CHANGE_ME@127.0.0.1:5432/amai
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
SETUP_TOKEN_TTL_HOURS=72
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Private S3-compatible storage (MinIO on the VPS, or AWS S3 / Backblaze B2 / Cloudflare R2)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=amai-private
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true
S3_URL_TTL_SEC=300

# Upload limits (bytes) — the app reads them from GET /api/v1/media/limits
MAX_IMAGE_BYTES=16777216
MAX_VIDEO_BYTES=104857600
MAX_AUDIO_BYTES=33554432
MAX_DOCUMENT_BYTES=104857600
MAX_RECORDING_BYTES=314572800
IMAGE_MAX_DIMENSION=2560
VIDEO_MAX_SECONDS=180

MESSAGE_EDIT_WINDOW_MIN=15
MESSAGE_DELETE_WINDOW_HOURS=48

# Firebase Admin service-account JSON (Firebase console → Project settings → Service accounts)
FIREBASE_SERVICE_ACCOUNT_PATH=/etc/amai/firebase-service-account.json
FCM_ENABLED=true

# WebRTC. TURN_SECRET must equal coturn's static-auth-secret.
STUN_URLS=stun:turn.example.com:3478
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_SECRET=CHANGE_ME
TURN_TTL_SEC=3600
CALL_RING_TIMEOUT_SEC=45
RECORDING_RETENTION_DAYS=90

# Run background jobs inside the API process (true) or via `npm run start:worker` (false)
RUN_WORKER_IN_PROCESS=true
