// Amai — PostgreSQL schema (Prisma 7, driver adapter: @prisma/adapter-pg)
// The hand-checked SQL for this schema lives in prisma/migrations/.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Accounts & sessions ----------

/// Exactly two rows can ever exist: slot is CHECK (slot IN (1,2)) and UNIQUE.
model AuthorizedAccount {
  id                  String    @id @default(uuid()) @db.Uuid
  slot                Int       @unique @db.SmallInt
  email               String    @unique @db.Citext
  setupTokenHash      String?   @map("setup_token_hash")
  setupTokenExpiresAt DateTime? @map("setup_token_expires_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user                User?

  @@map("authorized_accounts")
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  authorizedAccountId String    @unique @map("authorized_account_id") @db.Uuid
  email               String    @unique @db.Citext
  passwordHash        String    @map("password_hash")
  displayName         String    @map("display_name") @db.VarChar(60)
  about               String    @default("") @db.VarChar(280)
  avatarObjectKey     String?   @map("avatar_object_key")
  lastSeenAt          DateTime? @map("last_seen_at") @db.Timestamptz(6)
  failedLoginCount    Int       @default(0) @map("failed_login_count")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  authorizedAccount AuthorizedAccount       @relation(fields: [authorizedAccountId], references: [id], onDelete: Restrict)
  sessions          DeviceSession[]
  participants      ConversationParticipant[]
  messages          Message[]               @relation("MessageSender")
  pinnedMessages    Message[]               @relation("MessagePinner")
  receipts          MessageReceipt[]
  reactions         Reaction[]
  attachments       MessageAttachment[]
  statuses          Status[]
  statusViews       StatusView[]
  callsMade         CallRecord[]            @relation("CallCaller")
  callsReceived     CallRecord[]            @relation("CallCallee")
  recordings        CallRecording[]         @relation("RecordingOwner")
  settings          UserSettings?
  theme             ThemePreference?
  identityKeys      IdentityKey[]
  keyBackup         KeyBackup?
  auditEvents       AuditEvent[]

  @@map("users")
}

model DeviceSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  deviceName String    @map("device_name") @db.VarChar(120)
  platform   String    @default("android") @db.VarChar(20)
  ip         String?   @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason String? @map("revoke_reason") @db.VarChar(60)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  pushTokens    PushToken[]

  @@index([userId, revokedAt])
  @@map("device_sessions")
}

/// Rotating refresh tokens. Only SHA-256 hashes are stored.
/// Presenting a token whose usedAt is set => reuse => whole session revoked.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session DeviceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

model PushToken {
  id         String    @id @default(uuid()) @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  token      String    @unique
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  invalidAt  DateTime? @map("invalid_at") @db.Timestamptz(6)

  session DeviceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("push_tokens")
}

// ---------- End-to-end encryption key material (public / encrypted only) ----------

model IdentityKey {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  publicKey String    @map("public_key") @db.VarChar(64) // base64 X25519 public key
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("identity_keys")
}

/// Private key encrypted on-device with a key derived (Argon2id) from a backup passphrase
/// the server never sees.
model KeyBackup {
  userId     String   @id @map("user_id") @db.Uuid
  ciphertext String
  nonce      String   @db.VarChar(64)
  salt       String   @db.VarChar(64)
  kdfParams  Json     @map("kdf_params")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("key_backups")
}

// ---------- Conversations & messages ----------

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  conversationId String   @map("conversation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  joinedAt       DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_participants")
}

enum MessageType {
  text
  image
  video
  audio
  voice
  document
  location
  live_location
  contact
  sticker
  gif
  link
  status_reply
  call_event

  @@map("message_type")
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  senderId       String      @map("sender_id") @db.Uuid
  clientId       String      @map("client_id") @db.VarChar(64)
  type           MessageType
  /// XChaCha20-Poly1305 ciphertext (base64). NULL once deleted for everyone.
  ciphertext     String?
  nonce          String?     @db.VarChar(64)
  encVersion     Int         @default(1) @map("enc_version") @db.SmallInt
  replyToId      String?     @map("reply_to_id") @db.Uuid
  forwarded      Boolean     @default(false)
  statusId       String?     @map("status_id") @db.Uuid
  pinnedAt       DateTime?   @map("pinned_at") @db.Timestamptz(6)
  pinnedById     String?     @map("pinned_by_id") @db.Uuid
  editedAt       DateTime?   @map("edited_at") @db.Timestamptz(6)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Monotonic change counter (sequence "message_sync_seq"); bumped on every change. Used by /sync.
  syncSeq        BigInt      @default(dbgenerated("nextval('message_sync_seq'::regclass)")) @map("sync_seq")

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  pinnedBy     User?               @relation("MessagePinner", fields: [pinnedById], references: [id], onDelete: SetNull)
  replyTo      Message?            @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]           @relation("MessageReply")
  status       Status?             @relation(fields: [statusId], references: [id], onDelete: SetNull)
  attachments  MessageAttachment[]
  receipts     MessageReceipt[]
  reactions    Reaction[]

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([conversationId, syncSeq])
  @@index([conversationId, pinnedAt])
  @@map("messages")
}

enum AttachmentKind {
  image
  video
  audio
  voice
  document
  sticker
  status_media
  avatar
  call_recording

  @@map("attachment_kind")
}

/// Encrypted blobs in private S3 storage. Server only knows size/kind, never content.
model MessageAttachment {
  id         String         @id @default(uuid()) @db.Uuid
  uploaderId String         @map("uploader_id") @db.Uuid
  messageId  String?        @map("message_id") @db.Uuid
  kind       AttachmentKind
  objectKey  String         @unique @map("object_key")
  sizeBytes  BigInt         @map("size_bytes")
  uploadedAt DateTime?      @map("uploaded_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt  DateTime?      @map("deleted_at") @db.Timestamptz(6)

  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  message  Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([uploaderId, createdAt])
  @@map("message_attachments")
}

model MessageReceipt {
  messageId   String    @map("message_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, readAt])
  @@map("message_receipts")
}

model Reaction {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  emoji     String   @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@map("reactions")
}

// ---------- Status / stories ----------

enum StatusKind {
  photo
  video
  text

  @@map("status_kind")
}

model Status {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  kind         StatusKind
  ciphertext   String
  nonce        String     @db.VarChar(64)
  attachmentId String?    @unique @map("attachment_id") @db.Uuid
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  views    StatusView[]
  replies  Message[]

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("statuses")
}

model StatusView {
  statusId String   @map("status_id") @db.Uuid
  viewerId String   @map("viewer_id") @db.Uuid
  viewedAt DateTime @default(now()) @map("viewed_at") @db.Timestamptz(6)

  status Status @relation(fields: [statusId], references: [id], onDelete: Cascade)
  viewer User   @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@id([statusId, viewerId])
  @@map("status_views")
}

// ---------- Calls ----------

enum CallType {
  voice
  video

  @@map("call_type")
}

enum CallState {
  ringing
  accepted
  rejected
  missed
  ended
  failed
  cancelled

  @@map("call_state")
}

model CallRecord {
  id         String    @id @default(uuid()) @db.Uuid
  callerId   String    @map("caller_id") @db.Uuid
  calleeId   String    @map("callee_id") @db.Uuid
  type       CallType
  state      CallState @default(ringing)
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  answeredAt DateTime? @map("answered_at") @db.Timestamptz(6)
  endedAt    DateTime? @map("ended_at") @db.Timestamptz(6)
  endReason  String?   @map("end_reason") @db.VarChar(40)

  caller     User            @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee     User            @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Cascade)
  recordings CallRecording[]

  @@index([callerId, startedAt(sort: Desc)])
  @@index([calleeId, startedAt(sort: Desc)])
  @@map("call_records")
}

model CallRecording {
  id            String    @id @default(uuid()) @db.Uuid
  callId        String    @map("call_id") @db.Uuid
  ownerId       String    @map("owner_id") @db.Uuid
  consentedById String    @map("consented_by_id") @db.Uuid
  consentedAt   DateTime  @map("consented_at") @db.Timestamptz(6)
  attachmentId  String?   @unique @map("attachment_id") @db.Uuid
  /// Encrypted metadata (file key, duration) — same E2EE envelope as messages.
  ciphertext    String?
  nonce         String?   @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  call  CallRecord @relation(fields: [callId], references: [id], onDelete: Cascade)
  owner User       @relation("RecordingOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@map("call_recordings")
}

// ---------- Settings ----------

enum NotificationPreview {
  full
  sender_only
  hidden

  @@map("notification_preview")
}

model UserSettings {
  userId                String              @id @map("user_id") @db.Uuid
  showLastSeen          Boolean             @default(true) @map("show_last_seen")
  showOnline            Boolean             @default(true) @map("show_online")
  readReceipts          Boolean             @default(true) @map("read_receipts")
  typingIndicators      Boolean             @default(true) @map("typing_indicators")
  notificationPreview   NotificationPreview @default(full) @map("notification_preview")
  messageSound          String              @default("system_default") @map("message_sound") @db.VarChar(40)
  callRingtone          String              @default("system_default") @map("call_ringtone") @db.VarChar(40)
  vibrate               Boolean             @default(true)
  statusNotifications   Boolean             @default(true) @map("status_notifications")
  deliveryNotifications Boolean             @default(false) @map("delivery_notifications")
  autoDownload          Json                @default("{\"wifi\":[\"image\",\"voice\",\"video\",\"document\"],\"mobile\":[\"image\",\"voice\"]}") @map("auto_download")
  mediaQuality          String              @default("standard") @map("media_quality") @db.VarChar(20)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model ThemePreference {
  userId      String   @id @map("user_id") @db.Uuid
  mode        String   @default("dark") @db.VarChar(10)
  accent      String   @default("rose") @db.VarChar(20)
  bubbleStyle String   @default("rounded") @map("bubble_style") @db.VarChar(20)
  fontScale   Float    @default(1.0) @map("font_scale") @db.Real
  wallpaper   String   @default("none") @db.VarChar(80)
  haptics     Boolean  @default(true)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("theme_preferences")
}

// ---------- Audit ----------

model AuditEvent {
  id        BigInt   @id @default(autoincrement())
  userId    String?  @map("user_id") @db.Uuid
  type      String   @db.VarChar(60)
  ip        String?  @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(300)
  meta      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@map("audit_events")
}
